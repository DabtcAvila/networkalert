{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "networkalert",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Solo lo dinámico pasa por el Worker; las páginas se sirven como assets (gratis y sin límite de invocaciones).
    "run_worker_first": ["/api/*", "/health", "/feed.xml", "/feed.json", "/badge.svg"]
  },
  "routes": [{ "pattern": "networkalert.dev", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true },
  // La llave del recolector (NA_INGEST_KEY) va con `wrangler secret put`, nunca aquí.
  "kv_namespaces": [{ "binding": "NA_KV", "id": "af05eed469d5456daf6b33b8899e0cc8" }],
  "ratelimits": [
    { "name": "LIMITE", "namespace_id": "7101", "simple": { "limit": 120, "period": 60 } },
    { "name": "LIMITE_REVISAR", "namespace_id": "7103", "simple": { "limit": 12, "period": 60 } }
  ],
  // Workers AI (cuota gratuita): traduce los títulos de las alertas al español.
  "ai": { "binding": "AI" },
  "env": {
    // Preview: networkalert-preview.<cuenta>.workers.dev, mismo código, sin dominio.
    "preview": {
      "name": "networkalert-preview",
      "workers_dev": true,
      // Imprescindible: sin esto el entorno hereda `routes` y se lleva el dominio de producción.
      "routes": [],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "drop-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": ["/api/*", "/health", "/feed.xml", "/feed.json", "/badge.svg"]
      },
      "kv_namespaces": [{ "binding": "NA_KV", "id": "161767bc071e4fee8f0a0bb31e5fa05e" }],
      "ratelimits": [
        { "name": "LIMITE", "namespace_id": "7102", "simple": { "limit": 120, "period": 60 } },
        { "name": "LIMITE_REVISAR", "namespace_id": "7104", "simple": { "limit": 12, "period": 60 } }
      ],
      "ai": { "binding": "AI" },
      "observability": { "enabled": true }
    }
  }
}
