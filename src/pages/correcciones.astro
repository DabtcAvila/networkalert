---
import Base from '../layouts/Base.astro';
import Portadilla from '../components/Portadilla.astro';
// Registro de solo agregar: nunca se edita ni se borra una entrada anterior.
const correcciones: { fecha: string; decia: string; dice: string; deteccion: string; remedio: string }[] = [
  {
    fecha: '2026-11-14',
    decia: 'Varios títulos traducidos decían «servicio de denegación» en vez de «denegación de servicio», y cuatro alertas pedían instalar la corrección «para Multiple Products», con esas dos palabras en inglés.',
    dice: '«Denegación de servicio» y «para varios de sus productos». El título original en inglés siempre estuvo visible en cada alerta.',
    deteccion: 'revisión propia de las 87 alertas publicadas',
    remedio: 'glosario de traducción corregido, comprobación que descarta esas frases y todos los títulos traducidos de nuevo',
  },
  {
    fecha: '2026-11-14',
    decia: '27 alertas de fallas en ataque decían «CISA da a las agencias de EE. UU. hasta el…» con una fecha que ya había pasado, como si el plazo siguiera abierto.',
    dice: 'Cuando la fecha límite ya pasó, la alerta dice que venció y que hay que corregir cuanto antes.',
    deteccion: 'revisión propia de las 87 alertas publicadas',
    remedio: 'el texto de «Qué hacer» se arma en cada lectura comparando la fecha límite con el día de hoy',
  },
  {
    fecha: '2026-11-14',
    decia: 'Una falla de Microsoft 365 del 12 de noviembre apareció unos 15 minutos como alerta «alta» y «activa», con el título «Corte: technical problem» y sin país.',
    dice: 'Es un registro informativo de una falla de plataforma que ya había pasado: «Falla de plataforma: problema técnico».',
    deteccion: 'revisión propia al activar la fuente Cloudflare Radar',
    remedio: 'un registro de Radar sin fecha de fin solo cuenta como en curso durante 24 horas, y «alta» queda solo para un país entero sin conexión',
  },
  {
    fecha: '2026-11-14',
    decia: '«Revisa tu dominio» y los avisos de «Mi lista» decían «Falta el registro DMARC» en subdominios cuyo dominio principal sí lo tiene, y para arreglarlo señalaban un menú de Cloudflare aunque el dominio no usara Cloudflare. Con un sitio caído también decían «No dice a quién avisar si alguien encuentra una falla», sin haber podido leerlo.',
    dice: 'Si el subdominio no tiene regla propia se usa la del dominio principal y se dice de dónde viene. La indicación para agregarla ya no nombra a ningún proveedor. Lo que no se pudo leer no se afirma.',
    deteccion: 'revisión propia de un aviso enviado por correo',
    remedio: 'la regla DMARC se busca subiendo un nivel a la vez, como hacen los servidores de correo, y el archivo security.txt solo se reporta cuando el sitio abrió',
  },
  {
    fecha: '2026-11-14',
    decia: '«Revisa tu dominio» tenía tres errores más. A un sitio con el candado vencido o mal instalado le decía «El sitio responde con error 526. Es una falla del servidor». A sitios sanos que bloquean las lecturas automáticas (google.com, por ejemplo) les ponía «Por atender: la portada responde con error 429». Y decía que la versión sin candado (http) no mandaba a la versión segura cuando sí lo hacía, pero en el segundo salto.',
    dice: 'Un candado que no es válido se reporta como tal. Si el sitio bloquea la revisión, se dice eso y no se acusa una falla. La redirección de http se sigue completa, hasta cinco saltos. Cuando la portada no abrió, no se opina de protecciones del navegador, www ni security.txt.',
    deteccion: 'prueba propia contra una lista fija de 13 dominios de estado conocido, creada ese día',
    remedio: 'la lista fija (scripts/prueba-revisor.mjs, en el repositorio) se corre antes de publicar cualquier cambio del revisor; cada error nuevo se agrega ahí como caso',
  },
];
---
<Base title="Correcciones" description="Registro público de errores propios de Network Alert y cómo se corrigieron.">
  <Portadilla eyebrow="Transparencia" titulo="Correc<em>ciones</em>" lead="Nuestros errores quedan escritos aquí. No se editan ni se borran." ilustracion="correcciones">
    <a class="btn btn--primary" href="mailto:contacto@networkalert.dev">Reportar un error</a>
    <a class="enlace-flecha" href="/metodologia">Cómo se clasifica</a>
  </Portadilla>
  <section class="banda"><div class="container--narrow stack">
    {correcciones.length === 0
      ? <div class="vacio-grande rev"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21a9 9 0 100-18 9 9 0 000 18zM8 12l3 3 5-6" /></svg><h2>Sin correcciones hasta ahora</h2><p>Cuando haya una, aparecerá con fecha y detalle.</p></div>
      : <ul class="alertas">{correcciones.map((c) => <li class="alerta"><p class="alerta__cab"><time datetime={c.fecha}>{c.fecha}</time></p><p><strong>Decía:</strong> {c.decia}</p><p><strong>Dice:</strong> {c.dice}</p><p class="meta">Detección: {c.deteccion} · Remedio: {c.remedio}</p></li>)}</ul>}
    <div class="prose">
      <p>¿Viste un error? Escribe a <a href="mailto:contacto@networkalert.dev">contacto@networkalert.dev</a> con el identificador de la alerta.</p>
    </div>
  </div></section>
</Base>
