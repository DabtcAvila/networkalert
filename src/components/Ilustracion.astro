---
/**
 * Ilustraciones animadas de las portadillas. Dibujo de línea propio, en SVG, movido solo con CSS
 * (clases il-* en global.css), así que respetan «reducir movimiento» sin una línea de JS.
 */
interface Props { tipo: 'guia' | 'fuentes' | 'metodologia' | 'api' | 'apoyar' | 'correcciones' | 'privacidad' | 'perdido' | 'gracias' | 'vuln' | 'servidores' | 'senal' }
const { tipo } = Astro.props;
---
<svg class="il" viewBox="0 0 420 340" fill="none" aria-hidden="true" focusable="false">
  <circle class="il-halo" cx="210" cy="170" r="150" />
  {tipo === 'guia' && (
    <g class="il-flota">
      <rect class="il-carta" x="95" y="40" width="230" height="260" rx="16" />
      <rect class="il-acento" x="95" y="40" width="230" height="46" rx="16" />
      <rect class="il-acento" x="95" y="70" width="230" height="16" />
      <circle cx="120" cy="63" r="5" fill="#fff" opacity=".9" /><rect x="134" y="59" width="90" height="8" rx="4" fill="#fff" opacity=".8" />
      {[0, 1, 2, 3].map((i) => (
        <g style={`--i:${i}`}>
          <circle class="il-casilla" cx="128" cy={124 + i * 46} r="13" />
          <path class="il-palomita" d={`M121 ${124 + i * 46}l5 5 9-10`} />
          <rect class="il-linea" x="154" y={116 + i * 46} width={[130, 105, 140, 90][i]} height="8" rx="4" />
          <rect class="il-linea il-linea--2" x="154" y={130 + i * 46} width={[80, 120, 70, 110][i]} height="6" rx="3" />
        </g>
      ))}
    </g>
  )}
  {tipo === 'fuentes' && (
    <g>
      {[60, 115, 170, 225, 280].map((y, i) => (
        <g style={`--i:${i}`}>
          <path class="il-cable" d={`M92 ${y} C 150 ${y}, 150 170, 196 170`} />
          <rect class="il-carta" x="40" y={y - 18} width="56" height="36" rx="9" />
          <circle class="il-led" cx="58" cy={y} r="5" /><rect class="il-linea" x="68" y={y - 3} width="20" height="6" rx="3" />
        </g>
      ))}
      <g class="il-flota">
        <circle class="il-acento" cx="218" cy="170" r="30" />
        <circle cx="218" cy="170" r="42" class="il-anillo" />
        <path d="M206 170h24M218 158v24" stroke="#fff" stroke-width="3.5" stroke-linecap="round" />
      </g>
      <path class="il-cable il-cable--sale" d="M248 170h44" />
      <rect class="il-carta" x="292" y="105" width="96" height="130" rx="12" />
      {[0, 1, 2, 3].map((i) => <rect class="il-barra" style={`--i:${i}`} x="306" y={124 + i * 26} width={[66, 50, 60, 40][i]} height="9" rx="4.500" />)}
    </g>
  )}
  {tipo === 'metodologia' && (
    <g class="il-flota">
      <rect class="il-carta" x="70" y="52" width="280" height="236" rx="18" />
      <path d="M120 216a90 90 0 0 1 45-78" stroke="#12805c" stroke-width="18" stroke-linecap="round" />
      <path d="M177 131a90 90 0 0 1 66 0" stroke="#a87900" stroke-width="18" stroke-linecap="round" />
      <path d="M255 138a90 90 0 0 1 45 78" stroke="#d12b1f" stroke-width="18" stroke-linecap="round" />
      <g class="il-aguja"><path d="M210 216L210 142" stroke="#14132b" stroke-width="6" stroke-linecap="round" /></g>
      <circle cx="210" cy="216" r="13" fill="#14132b" /><circle cx="210" cy="216" r="5" fill="#fff" />
      {[0, 1, 2, 3, 4].map((i) => <rect class="il-barra" style={`--i:${i}`} x={126 + i * 36} y="250" width="26" height="9" rx="4.500" />)}
    </g>
  )}
  {tipo === 'api' && (
    <g>
      <g class="il-flota">
        <rect x="60" y="62" width="300" height="216" rx="16" fill="#14132b" />
        <rect x="60" y="62" width="300" height="38" rx="16" fill="#1e1c3d" /><rect x="60" y="86" width="300" height="14" fill="#1e1c3d" />
        <circle cx="82" cy="81" r="5" fill="#ff6b6b" /><circle cx="98" cy="81" r="5" fill="#ffc24b" /><circle cx="114" cy="81" r="5" fill="#4fd18b" />
        <path d="M82 128l10 8-10 8" stroke="#a99bff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        {[[104, 132, 150, '#e9e8ff'], [82, 162, 210, '#8f8db0'], [82, 186, 170, '#7ee0a8'], [82, 210, 120, '#8f8db0'], [82, 234, 190, '#7ee0a8']].map(([x, y, w, c], i) => <rect class="il-teclea" style={`--i:${i};--w:${w}px`} x={x} y={y} width={w} height="8" rx="4" fill={c as string} />)}
        <rect class="il-cursor" x="262" y="128" width="9" height="16" rx="2" fill="#fff" />
      </g>
      <g class="il-flota il-flota--2"><rect class="il-acento" x="286" y="218" width="96" height="74" rx="14" /><path d="M318 240c-8 0-6 14-14 15 8 1 6 15 14 15M350 240c8 0 6 14 14 15-8 1-6 15-14 15" stroke="#fff" stroke-width="3.500" stroke-linecap="round" /></g>
    </g>
  )}
  {tipo === 'apoyar' && (
    <g>
      <circle class="il-onda" cx="210" cy="170" r="70" /><circle class="il-onda il-onda--2" cx="210" cy="170" r="70" />
      <g class="il-late"><path class="il-acento" d="M210 246s-74-44-74-98a42 42 0 0 1 74-27 42 42 0 0 1 74 27c0 54-74 98-74 98z" /><path d="M176 134a22 22 0 0 1 18-12" stroke="#fff" stroke-width="5" stroke-linecap="round" opacity=".7" /></g>
      {[[92, 96], [330, 110], [112, 250], [316, 244], [210, 52]].map(([x, y], i) => <path class="il-chispa" style={`--i:${i}`} d={`M${x} ${y - 9}v18M${x - 9} ${y}h18`} />)}
    </g>
  )}
  {tipo === 'correcciones' && (
    <g class="il-flota">
      <rect class="il-carta" x="105" y="38" width="210" height="264" rx="16" />
      {[0, 1, 2, 3, 4, 5].map((i) => <rect class="il-linea" x="132" y={74 + i * 34} width={[150, 120, 156, 100, 140, 90][i]} height="9" rx="4.500" />)}
      <path class="il-tacha" d="M126 146h168" />
      <rect class="il-nueva" x="132" y="159" width="136" height="9" rx="4.500" />
      <g class="il-lapiz"><path d="M300 236l34-34 14 14-34 34-18 4z" class="il-acento" /><path d="M300 236l14 14" stroke="#fff" stroke-width="2.500" /></g>
    </g>
  )}
  {tipo === 'privacidad' && (
    <g>
      <circle class="il-onda" cx="210" cy="170" r="74" /><circle class="il-onda il-onda--2" cx="210" cy="170" r="74" />
      <g class="il-flota">
        <path class="il-acento" d="M210 56l84 30v66c0 58-36 100-84 124-48-24-84-66-84-124V86z" />
        <path d="M210 76l66 24v52c0 46-28 82-66 102z" fill="#fff" opacity=".14" />
        <rect x="180" y="158" width="60" height="50" rx="9" fill="#fff" /><path d="M190 158v-14a20 20 0 0 1 40 0v14" stroke="#fff" stroke-width="8" stroke-linecap="round" />
        <circle cx="210" cy="180" r="6" fill="#5b3df5" /><path d="M210 184v10" stroke="#5b3df5" stroke-width="5" stroke-linecap="round" />
      </g>
      {[[70, 110], [352, 130], [86, 244], [338, 236]].map(([x, y], i) => <g class="il-chispa" style={`--i:${i}`}><circle cx={x} cy={y} r="11" /><path d={`M${x - 8} ${y + 8}L${x + 8} ${y - 8}`} /></g>)}
    </g>
  )}
  {tipo === 'perdido' && (
    <g>
      <circle class="il-carta" cx="210" cy="170" r="128" />
      <circle class="il-anillo" cx="210" cy="170" r="86" /><circle class="il-anillo" cx="210" cy="170" r="44" />
      <path class="il-anillo" d="M210 42v256M82 170h256" />
      <g class="il-barrido"><path d="M210 170L210 42A128 128 0 0 1 320 105z" fill="url(#il-g)" /></g>
      <defs><linearGradient id="il-g" x1="210" y1="42" x2="320" y2="170" gradientUnits="userSpaceOnUse"><stop stop-color="#5b3df5" stop-opacity=".45" /><stop offset="1" stop-color="#5b3df5" stop-opacity="0" /></linearGradient></defs>
      <circle cx="210" cy="170" r="7" fill="#14132b" />
      <g class="il-late il-late--lento"><circle cx="268" cy="118" r="20" fill="#fff" stroke="#d12b1f" stroke-width="3" /><path d="M262 112a6.500 6.500 0 1 1 9 6c-2 1-3 2-3 4M268 127v.5" stroke="#d12b1f" stroke-width="3" stroke-linecap="round" /></g>
    </g>
  )}
  {tipo === 'vuln' && (
    <g>
      <circle class="il-onda" cx="210" cy="170" r="78" /><circle class="il-onda il-onda--2" cx="210" cy="170" r="78" />
      <g class="il-flota">
        <path class="il-carta" d="M210 48l92 32v70c0 62-38 108-92 132-54-24-92-70-92-132V80z" />
        <path class="il-acento" d="M210 74l68 24v52c0 48-28 84-68 104-40-20-68-56-68-104V98z" />
        <path d="M210 118v52" stroke="#fff" stroke-width="12" stroke-linecap="round" /><circle cx="210" cy="198" r="8" fill="#fff" />
        <rect class="il-escaner" x="126" y="78" width="168" height="5" rx="2.500" />
      </g>
      {[[78, 96, 'CVE'], [322, 120, 'KEV'], [84, 250, 'npm'], [318, 246, 'pip']].map(([x, y, t], i) => <g class="il-etiqueta" style={`--i:${i}`}><rect x={Number(x) - 26} y={Number(y) - 13} width="52" height="26" rx="13" /><text x={x} y={Number(y) + 4.500} text-anchor="middle">{t}</text></g>)}
    </g>
  )}
  {tipo === 'servidores' && (
    <g>
      {/* Tu sitio */}
      <g class="il-flota">
        <rect class="il-carta" x="112" y="30" width="196" height="104" rx="14" />
        <path d="M112 58h196" stroke="#e4e1f7" stroke-width="1.500" />
        <circle cx="130" cy="44" r="4" fill="#ff6b6b" /><circle cx="143" cy="44" r="4" fill="#ffc24b" /><circle cx="156" cy="44" r="4" fill="#4fd18b" />
        <rect x="172" y="38" width="118" height="12" rx="6" fill="#f1eeff" /><text class="il-txt il-txt--chico" x="181" y="47.500">tusitio.com</text>
        <rect class="il-linea" x="130" y="74" width="92" height="9" rx="4.500" /><rect class="il-linea il-linea--2" x="130" y="92" width="130" height="7" rx="3.500" /><rect class="il-linea il-linea--2" x="130" y="108" width="74" height="7" rx="3.500" />
        <g class="il-sello il-sello--ok"><circle cx="284" cy="104" r="15" fill="#12805c" /><path d="M277 104l5 5 9-10" stroke="#fff" stroke-width="2.800" stroke-linecap="round" stroke-linejoin="round" /></g>
        <g class="il-sello il-sello--falla"><circle cx="284" cy="104" r="15" fill="#d9620b" /><path d="M284 96v9M284 111v.5" stroke="#fff" stroke-width="3" stroke-linecap="round" /></g>
      </g>
      {/* Conexiones: tu sitio depende de los tres */}
      <path class="il-conector" style="--i:0" d="M210 134v30c0 10-6 16-16 16H112c-10 0-16 6-16 16v20" />
      <path class="il-conector il-conector--falla" style="--i:1" d="M210 134v82" />
      <path class="il-conector" style="--i:2" d="M210 134v30c0 10 6 16 16 16h82c10 0 16 6 16 16v20" />
      <circle class="il-nudo" cx="210" cy="180" r="5" />
      {/* Proveedores */}
      {[['Hosting', 'M-9 -5h18v10h-18zM-5 9h10', 44], ['DNS', 'M0 -10a10 10 0 100 20 10 10 0 000-20zM-10 0h20M0 -10c4 3 4 17 0 20M0 -10c-4 3-4 17 0 20', 158], ['Pagos', 'M-10 -6h20v12h-20zM-10 -2h20M-6 3h5', 272]].map(([t, d, x], i) => (
        <g class:list={[i === 1 && 'il-tiembla']}>
          <rect class:list={['il-carta', i === 1 && 'il-carta--falla']} x={x} y="216" width="104" height="92" rx="14" />
          <circle cx={Number(x) + 28} cy="246" r="17" fill="#efecff" />
          <path d={d as string} transform={`translate(${Number(x) + 28} 246)`} stroke="#5b3df5" stroke-width="1.800" stroke-linecap="round" stroke-linejoin="round" />
          <text class="il-txt" x={Number(x) + 52} y="250.500">{t}</text>
          {i === 1 ? (
            <>
              <g class="il-sello il-sello--ok"><rect x={Number(x) + 10} y="274" width="84" height="22" rx="11" fill="#e3f5ec" /><circle cx={Number(x) + 23} cy="285" r="4" fill="#12805c" /><text class="il-txt il-txt--ok" x={Number(x) + 32} y="289">Operando</text></g>
              <g class="il-sello il-sello--falla"><rect x={Number(x) + 10} y="274" width="84" height="22" rx="11" fill="#fdeedd" /><circle class="il-parpadeo" cx={Number(x) + 23} cy="285" r="4" fill="#d9620b" /><text class="il-txt il-txt--falla" x={Number(x) + 32} y="289">Incidente</text></g>
            </>
          ) : (
            <g><rect x={Number(x) + 10} y="274" width="84" height="22" rx="11" fill="#e3f5ec" /><circle cx={Number(x) + 23} cy="285" r="4" fill="#12805c" /><text class="il-txt il-txt--ok" x={Number(x) + 32} y="289">Operando</text></g>
          )}
        </g>
      ))}
    </g>
  )}
  {tipo === 'senal' && (
    <g>
      <defs>
        <linearGradient id="il-area" x1="0" y1="96" x2="0" y2="200" gradientUnits="userSpaceOnUse"><stop stop-color="#5b3df5" stop-opacity=".28" /><stop offset="1" stop-color="#5b3df5" stop-opacity="0" /></linearGradient>
        <clipPath id="il-recorte"><rect class="il-cortina" x="74" y="88" width="272" height="116" /></clipPath>
      </defs>
      <g class="il-flota">
        <rect class="il-carta" x="50" y="36" width="320" height="270" rx="18" />
        {/* Encabezado: país y ventana de tiempo */}
        <circle class="il-parpadeo" cx="76" cy="64" r="5" fill="#d12b1f" />
        <text class="il-txt" x="90" y="68.500">Conectividad del país</text>
        <rect x="266" y="53" width="44" height="22" rx="11" fill="#f1eeff" /><text class="il-txt il-txt--chico il-txt--centro" x="288" y="68">24 h</text>
        {/* Gráfica */}
        <path d="M74 104h272M74 136h272M74 168h272M74 200h272" stroke="#ebe8fa" stroke-width="1.200" />
        <g clip-path="url(#il-recorte)">
          <path d="M74 126C98 118 120 134 146 128S190 112 214 121S240 125 252 126C266 128 262 186 278 186C294 186 304 150 346 140V200H74z" fill="url(#il-area)" />
          <path d="M74 126C98 118 120 134 146 128S190 112 214 121S240 125 252 126C266 128 262 186 278 186C294 186 304 150 346 140" stroke="#5b3df5" stroke-width="3.500" stroke-linecap="round" stroke-linejoin="round" />
        </g>
        <path class="il-marca" d="M278 96v104" stroke="#d12b1f" stroke-width="1.500" stroke-dasharray="3 4" />
        <g class="il-punto"><circle class="il-punto__onda" cx="278" cy="186" r="9" /><circle cx="278" cy="186" r="7" fill="#d12b1f" stroke="#fff" stroke-width="3" /></g>
        <g class="il-globito"><rect x="222" y="146" width="50" height="24" rx="8" fill="#14132b" /><path d="M262 170l8 8v-8z" fill="#14132b" /><text class="il-txt il-txt--blanco il-txt--centro" x="247" y="162.500">−63 %</text></g>
        {/* Las tres señales que mide IODA */}
        {[['BGP', 0.92, false], ['Sondeo', 0.38, true], ['Tráfico', 0.3, true]].map(([t, k, cae], i) => (
          <g>
            <text class="il-txt il-txt--chico" x="74" y={233 + i * 24}>{t}</text>
            <rect x="132" y={225 + i * 24} width="214" height="9" rx="4.500" fill="#efedf8" />
            <rect class:list={['il-senal', cae && 'il-senal--cae']} style={`--k:${k};--i:${i}`} x="132" y={225 + i * 24} width="214" height="9" rx="4.500" />
          </g>
        ))}
      </g>
      {/* Antena: emite, y se corta cuando cae la señal */}
      <g class="il-flota il-flota--2">
        <circle cx="356" cy="52" r="30" fill="#fff" stroke="#d8d4f5" stroke-width="1.500" filter="drop-shadow(0 8px 12px rgb(20 19 43 / .16))" />
        <path d="M356 46v22M348 68h16M356 46l-7 22M356 46l7 22" stroke="#5b3df5" stroke-width="2.200" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="356" cy="44" r="3.500" fill="#5b3df5" />
        <path class="il-emite" style="--i:0" d="M347 37a12 12 0 0 1 18 0" /><path class="il-emite" style="--i:1" d="M341 31a20 20 0 0 1 30 0" />
        <path class="il-corte" d="M338 34l36 36" />
      </g>
    </g>
  )}
  {tipo === 'gracias' && (
    <g>
      <circle class="il-onda" cx="210" cy="170" r="74" /><circle class="il-onda il-onda--2" cx="210" cy="170" r="74" />
      <circle class="il-acento" cx="210" cy="170" r="78" />
      <path class="il-palomita il-palomita--grande" d="M172 172l26 26 46-52" />
      {[[92, 96], [330, 110], [112, 250], [316, 244], [210, 52], [210, 292]].map(([x, y], i) => <path class="il-chispa" style={`--i:${i}`} d={`M${x} ${y - 9}v18M${x - 9} ${y}h18`} />)}
    </g>
  )}
</svg>
